    {
      "name": "Conversational Chat (Memory)",
      "item": [
        {
          "name": "Start New Conversation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.conversationId) {",
                  "    pm.collectionVariables.set('conversationId', jsonData.conversationId);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Find Selenium testers with more than 10 years of experience\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat"
              ]
            },
            "description": "Start a new conversation (auto-saves conversationId)"
          },
          "response": []
        },
        {
          "name": "Continue Conversation (Follow-up)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"From those, filter only candidates only above 6 years\",\n  \"conversationId\": \"{{conversationId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat"
              ]
            },
            "description": "Continue conversation with memory context"
          },
          "response": []
        },
        {
          "name": "Filter Results (Conversational)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Now show me only the ones in 13 years\",\n  \"conversationId\": \"{{conversationId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat"
              ]
            },
            "description": "Filter previous results without new search"
          },
          "response": []
        },
        {
          "name": "Get Conversation History",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversationId\": \"{{conversationId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chat/history",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "history"
              ]
            },
            "description": "Get full chat history for a conversation"
          },
          "response": []
        },
        {
          "name": "Delete Conversation",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/chat/{{conversationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "{{conversationId}}"
              ]
            },
            "description": "Delete conversation and clear memory"
          },
          "response": []
        }
      ]
